{{ 'pdp-reviews.css' | asset_url | stylesheet_tag }}

<section
  id="pdp-reviews-{{ section.id }}"
  class="pdp-reviews"
  style="
    --pdp-reviews-heading-color: {{ section.settings.heading_color }};
    --pdp-reviews-padding-top: {{ section.settings.padding-block-start }}px;
    --pdp-reviews-padding-bottom: {{ section.settings.padding-block-end }}px;
  "
>
  {%- comment -%} Header {%- endcomment -%}
  <div class="pdp-reviews__header">
    <div class="pdp-reviews__header-left">
      <h2 class="pdp-reviews__title">{{ section.settings.section_heading | escape }}</h2>
      <div class="pdp-reviews__header-meta">
        <div class="pdp-reviews__header-stars">
          <img class="pdp-reviews__header-star" src="{{ 'svg-51.svg' | asset_url }}" alt="" role="presentation" width="18" height="18" loading="lazy">
          <img class="pdp-reviews__header-star" src="{{ 'svg-52.svg' | asset_url }}" alt="" role="presentation" width="18" height="18" loading="lazy">
          <img class="pdp-reviews__header-star" src="{{ 'svg-53.svg' | asset_url }}" alt="" role="presentation" width="18" height="18" loading="lazy">
          <img class="pdp-reviews__header-star" src="{{ 'svg-51.svg' | asset_url }}" alt="" role="presentation" width="18" height="18" loading="lazy">
          <img class="pdp-reviews__header-star" src="{{ 'svg-52.svg' | asset_url }}" alt="" role="presentation" width="18" height="18" loading="lazy">
        </div>
        <span class="pdp-reviews__header-rating">{{ section.settings.average_rating | escape }}</span>
        {%- if section.settings.verified_logo != blank -%}
          <img
            class="pdp-reviews__verified-logo"
            src="{{ section.settings.verified_logo | image_url: width: 202 }}"
            alt="Verified reviews"
            width="101"
            height="16"
            loading="lazy"
          >
        {%- endif -%}
      </div>
    </div>
    <button type="button" class="pdp-reviews__collapse-btn" aria-label="Toggle reviews section">
      <img class="pdp-reviews__collapse-icon" src="{{ 'svg-56.svg' | asset_url }}" alt="" role="presentation" width="24" height="24" loading="lazy">
    </button>
  </div>

  {%- comment -%} Body: Sidebar + Main {%- endcomment -%}
  <div class="pdp-reviews__body">
    {%- comment -%} Sidebar {%- endcomment -%}
    <div class="pdp-reviews__sidebar">
      {%- comment -%} Review this product {%- endcomment -%}
      <div class="pdp-reviews__review-prompt">
        <h3 class="pdp-reviews__subtitle">Review this product</h3>
        <div class="pdp-reviews__progressive-question">
          <span class="pdp-reviews__progressive-text">Progressively submit review?</span>
        </div>
        <div class="pdp-reviews__radio-group" role="radiogroup" aria-label="Progressively submit review">
          <label class="pdp-reviews__radio-option">
            <input type="radio" class="pdp-reviews__radio-input" name="progressive-review" value="yes">
            <span class="pdp-reviews__radio-label">Yes</span>
          </label>
          <label class="pdp-reviews__radio-option">
            <input type="radio" class="pdp-reviews__radio-input" name="progressive-review" value="no" checked>
            <span class="pdp-reviews__radio-label">No</span>
          </label>
        </div>
        <div class="pdp-reviews__star-selector-wrap">
          <div class="pdp-reviews__star-selector">
            <button type="button" class="pdp-reviews__star-select-btn" aria-label="Rate 1 star">
              <img class="pdp-reviews__star-select-icon" src="{{ 'svg-7.svg' | asset_url }}" alt="" role="presentation" width="20" height="20">
            </button>
            <button type="button" class="pdp-reviews__star-select-btn" aria-label="Rate 2 stars">
              <img class="pdp-reviews__star-select-icon" src="{{ 'svg-8.svg' | asset_url }}" alt="" role="presentation" width="20" height="20">
            </button>
            <button type="button" class="pdp-reviews__star-select-btn" aria-label="Rate 3 stars">
              <img class="pdp-reviews__star-select-icon" src="{{ 'svg-9.svg' | asset_url }}" alt="" role="presentation" width="20" height="20">
            </button>
            <button type="button" class="pdp-reviews__star-select-btn" aria-label="Rate 4 stars">
              <img class="pdp-reviews__star-select-icon" src="{{ 'svg-10.svg' | asset_url }}" alt="" role="presentation" width="20" height="20">
            </button>
            <button type="button" class="pdp-reviews__star-select-btn" aria-label="Rate 5 stars">
              <img class="pdp-reviews__star-select-icon" src="{{ 'svg-11.svg' | asset_url }}" alt="" role="presentation" width="20" height="20">
            </button>
          </div>
          {%- if section.settings.verified_logo != blank -%}
            <img
              class="pdp-reviews__verified-logo pdp-reviews__verified-logo--mobile"
              src="{{ section.settings.verified_logo | image_url: width: 202 }}"
              alt="Verified reviews"
              width="101"
              height="16"
              loading="lazy"
            >
          {%- endif -%}
        </div>
      </div>

      <hr class="pdp-reviews__divider">

      {%- comment -%} Rating Breakdown {%- endcomment -%}
      <div class="pdp-reviews__breakdown">
        <div class="pdp-reviews__bar-row">
          <span class="pdp-reviews__bar-label">5 Stars</span>
          <div class="pdp-reviews__bar-track">
            <div class="pdp-reviews__bar-fill" style="width: 86%;"></div>
          </div>
          <span class="pdp-reviews__bar-pct">86%</span>
        </div>
        <div class="pdp-reviews__bar-row">
          <span class="pdp-reviews__bar-label">4 Stars</span>
          <div class="pdp-reviews__bar-track">
            <div class="pdp-reviews__bar-fill" style="width: 12%;"></div>
          </div>
          <span class="pdp-reviews__bar-pct">12%</span>
        </div>
        <div class="pdp-reviews__bar-row">
          <span class="pdp-reviews__bar-label">3 Stars</span>
          <div class="pdp-reviews__bar-track">
            <div class="pdp-reviews__bar-fill" style="width: 1%;"></div>
          </div>
          <span class="pdp-reviews__bar-pct">1%</span>
        </div>
        <div class="pdp-reviews__bar-row">
          <span class="pdp-reviews__bar-label">2 Stars</span>
          <div class="pdp-reviews__bar-track">
            <div class="pdp-reviews__bar-fill" style="width: 0%;"></div>
          </div>
          <span class="pdp-reviews__bar-pct">0%</span>
        </div>
        <div class="pdp-reviews__bar-row">
          <span class="pdp-reviews__bar-label">1 Star</span>
          <div class="pdp-reviews__bar-track">
            <div class="pdp-reviews__bar-fill" style="width: 0%;"></div>
          </div>
          <span class="pdp-reviews__bar-pct">0%</span>
        </div>
      </div>

      <hr class="pdp-reviews__divider">

      {%- comment -%} Average Rating {%- endcomment -%}
      <div class="pdp-reviews__average">
        <div class="pdp-reviews__average-top">
          <span class="pdp-reviews__average-number">{{ section.settings.average_rating | escape }}</span>
          <div class="pdp-reviews__average-detail">
            <div class="pdp-reviews__average-stars" aria-hidden="true">
              <img class="pdp-reviews__average-star-icon" src="{{ 'svg-12.svg' | asset_url }}" alt="" role="presentation" width="16" height="16">
              <img class="pdp-reviews__average-star-icon" src="{{ 'svg-13.svg' | asset_url }}" alt="" role="presentation" width="16" height="16">
              <img class="pdp-reviews__average-star-icon" src="{{ 'svg-14.svg' | asset_url }}" alt="" role="presentation" width="16" height="16">
              <img class="pdp-reviews__average-star-icon" src="{{ 'svg-15.svg' | asset_url }}" alt="" role="presentation" width="16" height="16">
              <img class="pdp-reviews__average-star-icon" src="{{ 'svg-16.svg' | asset_url }}" alt="" role="presentation" width="16" height="16">
            </div>
            <span class="pdp-reviews__average-count">{{ section.settings.total_reviews | escape }}</span>
          </div>
        </div>
        <p class="pdp-reviews__recommendation">{{ section.settings.recommendation_text | escape }}</p>
      </div>

      <hr class="pdp-reviews__divider">

      {%- comment -%} Filter Reviews By {%- endcomment -%}
      <div class="pdp-reviews__filter-section">
        <h3 class="pdp-reviews__filter-heading">Filter reviews by</h3>
        <div class="pdp-reviews__filter-pills">
          <button type="button" class="pdp-reviews__filter-pill">Satisfaction</button>
          <button type="button" class="pdp-reviews__filter-pill">Taste</button>
          <button type="button" class="pdp-reviews__filter-pill">Presentation</button>
          <button type="button" class="pdp-reviews__filter-pill">Delivery Experience</button>
          <button type="button" class="pdp-reviews__filter-pill">Freshness</button>
          <button type="button" class="pdp-reviews__filter-pill">Value for Money</button>
          <button type="button" class="pdp-reviews__filter-pill">Occasion (Birthday, Anniversary, etc.)</button>
          <button type="button" class="pdp-reviews__filter-pill">Quality</button>
          <button type="button" class="pdp-reviews__filter-pill">Overall Experience</button>
        </div>
      </div>

      <hr class="pdp-reviews__divider">

      {%- comment -%} Select Star Rating {%- endcomment -%}
      <div class="pdp-reviews__star-filter-section">
        <h3 class="pdp-reviews__star-filter-heading">Select star rating</h3>
        <div class="pdp-reviews__star-filters" role="group" aria-label="Filter by star rating">
          <button type="button" class="pdp-reviews__star-filter-btn" aria-label="Filter by 1 star">
            <img class="pdp-reviews__star-filter-icon" src="{{ 'svg-67.svg' | asset_url }}" alt="" role="presentation" width="12" height="12">
            <span>1</span>
          </button>
          <button type="button" class="pdp-reviews__star-filter-btn" aria-label="Filter by 2 stars">
            <img class="pdp-reviews__star-filter-icon" src="{{ 'svg-68.svg' | asset_url }}" alt="" role="presentation" width="12" height="12">
            <span>2</span>
          </button>
          <button type="button" class="pdp-reviews__star-filter-btn" aria-label="Filter by 3 stars">
            <img class="pdp-reviews__star-filter-icon" src="{{ 'svg-69.svg' | asset_url }}" alt="" role="presentation" width="12" height="12">
            <span>3</span>
          </button>
          <button type="button" class="pdp-reviews__star-filter-btn" aria-label="Filter by 4 stars">
            <img class="pdp-reviews__star-filter-icon" src="{{ 'svg-70.svg' | asset_url }}" alt="" role="presentation" width="12" height="12">
            <span>4</span>
          </button>
          <button type="button" class="pdp-reviews__star-filter-btn" aria-label="Filter by 5 stars">
            <img class="pdp-reviews__star-filter-icon" src="{{ 'svg-71.svg' | asset_url }}" alt="" role="presentation" width="12" height="12">
            <span>5</span>
          </button>
        </div>
      </div>
    </div>

    {%- comment -%} Main Content {%- endcomment -%}
    <div class="pdp-reviews__main">
      {%- comment -%} AI Summary {%- endcomment -%}
      <div class="pdp-reviews__ai-summary">
        <div class="pdp-reviews__ai-heading-row">
          <img class="pdp-reviews__ai-icon" src="{{ 'frame.svg' | asset_url }}" alt="" role="presentation" width="20" height="20">
          <h3 class="pdp-reviews__ai-heading">{{ section.settings.ai_summary_heading | escape }}</h3>
        </div>
        <p class="pdp-reviews__ai-text">{{ section.settings.ai_summary_text | escape }}</p>
      </div>

      {%- comment -%} Reviews List {%- endcomment -%}
      <div class="pdp-reviews__list-section">
        <div class="pdp-reviews__list-header">
          <span class="pdp-reviews__count-text">1-5 of 2983 reviews</span>
          <button type="button" class="pdp-reviews__sort-btn">
            <span>Sort by: Most relevant</span>
            <img class="pdp-reviews__sort-icon" src="{{ 'svg-22.svg' | asset_url }}" alt="" role="presentation" width="16" height="16">
          </button>
        </div>

        <div class="pdp-reviews__cards">
          {%- comment -%} Card 1 {%- endcomment -%}
          <div class="pdp-reviews__card">
            <h4 class="pdp-reviews__card-title">Beautiful and delicious!</h4>
            <div class="pdp-reviews__card-rating">
              <div class="pdp-reviews__card-stars" aria-label="5 out of 5 stars">
                <img class="pdp-reviews__card-star" src="{{ 'svg-23.svg' | asset_url }}" alt="" role="presentation" width="16" height="16">
                <img class="pdp-reviews__card-star" src="{{ 'svg-23.svg' | asset_url }}" alt="" role="presentation" width="16" height="16">
                <img class="pdp-reviews__card-star" src="{{ 'svg-23.svg' | asset_url }}" alt="" role="presentation" width="16" height="16">
                <img class="pdp-reviews__card-star" src="{{ 'svg-23.svg' | asset_url }}" alt="" role="presentation" width="16" height="16">
                <img class="pdp-reviews__card-star" src="{{ 'svg-23.svg' | asset_url }}" alt="" role="presentation" width="16" height="16">
              </div>
              <span class="pdp-reviews__card-rating-num">5</span>
            </div>
            <span class="pdp-reviews__card-meta">9 months ago by HappyCustomer21</span>
            <p class="pdp-reviews__card-body">The arrangement looked even better in person than online. The fruit was incredibly fresh and juicy, and the chocolate-covered strawberries were absolutely amazing. It made the perfect gift and arrived right on time. I'll definitely be ordering again!</p>
            <div class="pdp-reviews__card-actions">
              <span class="pdp-reviews__card-actions-label">Helpful?</span>
              <button type="button" class="pdp-reviews__card-action-btn" aria-label="Helpful">
                <img class="pdp-reviews__card-action-icon" src="{{ 'svg-28.svg' | asset_url }}" alt="" role="presentation" width="16" height="16">
                <span>(2)</span>
              </button>
              <button type="button" class="pdp-reviews__card-action-btn" aria-label="Not helpful">
                <img class="pdp-reviews__card-action-icon" src="{{ 'svg-29.svg' | asset_url }}" alt="" role="presentation" width="16" height="16">
                <span>(0)</span>
              </button>
              <span class="pdp-reviews__card-action-divider" aria-hidden="true"></span>
              <button type="button" class="pdp-reviews__card-report">Report</button>
            </div>
          </div>

          {%- comment -%} Card 2 {%- endcomment -%}
          <div class="pdp-reviews__card">
            <h4 class="pdp-reviews__card-title">Perfect gift choice</h4>
            <div class="pdp-reviews__card-rating">
              <div class="pdp-reviews__card-stars" aria-label="5 out of 5 stars">
                <img class="pdp-reviews__card-star" src="{{ 'svg-23.svg' | asset_url }}" alt="" role="presentation" width="16" height="16">
                <img class="pdp-reviews__card-star" src="{{ 'svg-23.svg' | asset_url }}" alt="" role="presentation" width="16" height="16">
                <img class="pdp-reviews__card-star" src="{{ 'svg-23.svg' | asset_url }}" alt="" role="presentation" width="16" height="16">
                <img class="pdp-reviews__card-star" src="{{ 'svg-23.svg' | asset_url }}" alt="" role="presentation" width="16" height="16">
                <img class="pdp-reviews__card-star" src="{{ 'svg-23.svg' | asset_url }}" alt="" role="presentation" width="16" height="16">
              </div>
              <span class="pdp-reviews__card-rating-num">5</span>
            </div>
            <span class="pdp-reviews__card-meta">9 months ago by GiftGiver88</span>
            <p class="pdp-reviews__card-body">I sent this as a birthday surprise, and it was a huge hit! The presentation was stunning, and everything tasted fresh and high quality. It's such a unique alternative to flowers or traditional gifts.</p>
            <div class="pdp-reviews__card-actions">
              <span class="pdp-reviews__card-actions-label">Helpful?</span>
              <button type="button" class="pdp-reviews__card-action-btn" aria-label="Helpful">
                <img class="pdp-reviews__card-action-icon" src="{{ 'svg-28.svg' | asset_url }}" alt="" role="presentation" width="16" height="16">
                <span>(2)</span>
              </button>
              <button type="button" class="pdp-reviews__card-action-btn" aria-label="Not helpful">
                <img class="pdp-reviews__card-action-icon" src="{{ 'svg-29.svg' | asset_url }}" alt="" role="presentation" width="16" height="16">
                <span>(0)</span>
              </button>
              <span class="pdp-reviews__card-action-divider" aria-hidden="true"></span>
              <button type="button" class="pdp-reviews__card-report">Report</button>
            </div>
          </div>

          {%- comment -%} Card 3 {%- endcomment -%}
          <div class="pdp-reviews__card">
            <h4 class="pdp-reviews__card-title">Fresh and beautifully arranged</h4>
            <div class="pdp-reviews__card-rating">
              <div class="pdp-reviews__card-stars" aria-label="5 out of 5 stars">
                <img class="pdp-reviews__card-star" src="{{ 'svg-23.svg' | asset_url }}" alt="" role="presentation" width="16" height="16">
                <img class="pdp-reviews__card-star" src="{{ 'svg-23.svg' | asset_url }}" alt="" role="presentation" width="16" height="16">
                <img class="pdp-reviews__card-star" src="{{ 'svg-23.svg' | asset_url }}" alt="" role="presentation" width="16" height="16">
                <img class="pdp-reviews__card-star" src="{{ 'svg-23.svg' | asset_url }}" alt="" role="presentation" width="16" height="16">
                <img class="pdp-reviews__card-star" src="{{ 'svg-23.svg' | asset_url }}" alt="" role="presentation" width="16" height="16">
              </div>
              <span class="pdp-reviews__card-rating-num">5</span>
            </div>
            <span class="pdp-reviews__card-meta">9 months ago by SweetTreatsFan</span>
            <p class="pdp-reviews__card-body">Every piece of fruit was perfectly ripe, and the arrangement was crafted so nicely. You can tell a lot of care goes into making these. Highly recommend for any special occasion!</p>
            <div class="pdp-reviews__card-actions">
              <span class="pdp-reviews__card-actions-label">Helpful?</span>
              <button type="button" class="pdp-reviews__card-action-btn" aria-label="Helpful">
                <img class="pdp-reviews__card-action-icon" src="{{ 'svg-28.svg' | asset_url }}" alt="" role="presentation" width="16" height="16">
                <span>(2)</span>
              </button>
              <button type="button" class="pdp-reviews__card-action-btn" aria-label="Not helpful">
                <img class="pdp-reviews__card-action-icon" src="{{ 'svg-29.svg' | asset_url }}" alt="" role="presentation" width="16" height="16">
                <span>(0)</span>
              </button>
              <span class="pdp-reviews__card-action-divider" aria-hidden="true"></span>
              <button type="button" class="pdp-reviews__card-report">Report</button>
            </div>
          </div>

          {%- comment -%} Card 4 {%- endcomment -%}
          <div class="pdp-reviews__card">
            <h4 class="pdp-reviews__card-title">Great experience overall</h4>
            <div class="pdp-reviews__card-rating">
              <div class="pdp-reviews__card-stars" aria-label="5 out of 5 stars">
                <img class="pdp-reviews__card-star" src="{{ 'svg-23.svg' | asset_url }}" alt="" role="presentation" width="16" height="16">
                <img class="pdp-reviews__card-star" src="{{ 'svg-23.svg' | asset_url }}" alt="" role="presentation" width="16" height="16">
                <img class="pdp-reviews__card-star" src="{{ 'svg-23.svg' | asset_url }}" alt="" role="presentation" width="16" height="16">
                <img class="pdp-reviews__card-star" src="{{ 'svg-23.svg' | asset_url }}" alt="" role="presentation" width="16" height="16">
                <img class="pdp-reviews__card-star" src="{{ 'svg-23.svg' | asset_url }}" alt="" role="presentation" width="16" height="16">
              </div>
              <span class="pdp-reviews__card-rating-num">5</span>
            </div>
            <span class="pdp-reviews__card-meta">9 months ago by CelebrationPlanner</span>
            <p class="pdp-reviews__card-body">Ordering was easy, delivery was on time, and the arrangement exceeded expectations. It looked elegant and tasted fantastic. Perfect for celebrations or just to brighten someone's day.</p>
            <div class="pdp-reviews__card-actions">
              <span class="pdp-reviews__card-actions-label">Helpful?</span>
              <button type="button" class="pdp-reviews__card-action-btn" aria-label="Helpful">
                <img class="pdp-reviews__card-action-icon" src="{{ 'svg-28.svg' | asset_url }}" alt="" role="presentation" width="16" height="16">
                <span>(2)</span>
              </button>
              <button type="button" class="pdp-reviews__card-action-btn" aria-label="Not helpful">
                <img class="pdp-reviews__card-action-icon" src="{{ 'svg-29.svg' | asset_url }}" alt="" role="presentation" width="16" height="16">
                <span>(0)</span>
              </button>
              <span class="pdp-reviews__card-action-divider" aria-hidden="true"></span>
              <button type="button" class="pdp-reviews__card-report">Report</button>
            </div>
          </div>
        </div>

        <button type="button" class="pdp-reviews__load-more">Load 5 more reviews</button>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:names.pdp_reviews",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section heading",
      "default": "Rating & Reviews"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#5F0300"
    },
    {
      "type": "text",
      "id": "average_rating",
      "label": "Average rating",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "total_reviews",
      "label": "Total reviews",
      "default": "2,994 reviews"
    },
    {
      "type": "text",
      "id": "recommendation_text",
      "label": "Recommendation text",
      "default": "98% of customers would recommend this product"
    },
    {
      "type": "image_picker",
      "id": "verified_logo",
      "label": "Verified logo"
    },
    {
      "type": "text",
      "id": "ai_summary_heading",
      "label": "AI summary heading",
      "default": "AI Generated Review Summary"
    },
    {
      "type": "textarea",
      "id": "ai_summary_text",
      "label": "AI summary text",
      "default": "Customers love the freshness, presentation, and taste of the arrangements. Highlights include beautifully crafted fruit designs, rich chocolate-dipped treats, and reliable delivery service. Many reviewers appreciate the perfect balance of sweetness and quality, making these arrangements ideal for gifts, celebrations, and special occasions. Overall, the brand is praised for creating memorable experiences with both visual appeal and flavor."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 80,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "t:names.pdp_reviews"
    }
  ]
}
{% endschema %}
